{
  "method": {
    "description": "授权模式",
    "type": "string",
    "options": ["OAuth", "api_key"],
    "labels": ["OAuth", "开发者 API key"],
    "default": "OAuth"
  },
  "api_key": {
    "description": "开发者 API key",
    "hint": "仅使用 开发者 API key 模式时需要填写",
    "type": "string",
    "default": ""
  },
  "client_id": {
    "description": "OAuth 客户端 ID",
    "hint": "除非你清楚这是什么，否则不要修改",
    "type": "string",
    "default": "405bddd9-c6cb-4307-b4fa-dbd48eb6a5db"
  },
  "redirect_uri": {
    "description": "OAuth 回调地址",
    "hint": "除非你清楚这是什么，否则不要修改",
    "type": "string",
    "default": "urn:ietf:wg:oauth:2.0:oob"
  },
  "rate_limit_interval": {
    "description": "全局请求间隔（秒）",
    "hint": "所有落雪 API 请求之间的最小间隔，防止高频请求；0 为不限制",
    "type": "float",
    "default": 1.0
  },
  "clear_kv_on_terminate": {
    "description": "停用时清除登录数据",
    "hint": "插件停用/重载时删除所有用户的 OAuth Token 与好友码绑定（含历史数据）；默认保留",
    "type": "bool",
    "default": false
  },
  "debug": {
    "description": "调试模式",
    "hint": "开启后输出更多调试日志",
    "type": "bool",
    "default": false
  }
}
